# Copy to .env (gitignored).

# Which Claude backend to use:
#   auto        -> API key if set, otherwise the Claude Code CLI (your Enterprise seat)
#   api         -> Anthropic API (needs ANTHROPIC_API_KEY, billed per token on console.anthropic.com)
#   claude_cli  -> headless Claude Code (`claude -p`), uses whatever account you logged into with `claude /login`
LLM_BACKEND=auto
ANTHROPIC_API_KEY=
# Optional explicit path to the claude binary if it is not on PATH.
CLAUDE_CLI_PATH=

# Models. Screening is one cheap-ish call per job; tailoring is the big one.
MODEL_SCREEN=claude-opus-5-5
MODEL_TAILOR=claude-opus-5-5
EFFORT_SCREEN=low
EFFORT_TAILOR=medium
# Revisions only patch the lines that failed a check, so they run at low effort.
EFFORT_REVISE=low

# Jobs screened / built at the same time (also the cap on simultaneous Claude calls).
PARALLEL_JOBS=3

# Pipeline limits (protect your usage).
POSTED_WITHIN_HOURS=24
MAX_SCREEN_PER_RUN=40
MAX_TAILOR_PER_RUN=8
MAX_REVISIONS=2
# Build documents for APPLY WITH RISK roles without asking (set 0 to approve each one yourself).
AUTO_TAILOR_RISK=1

# Optional: run the pipeline automatically every N minutes while `serve` is running (0 = off).
AUTORUN_EVERY_MINUTES=0
PORT=5055
